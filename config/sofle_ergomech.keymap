#define ZMK_POINTING_DEFAULT_MOVE_VAL 2000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10
#include <dt-bindings/zmk/pointing.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define CONTROLS 1
#define SYMBOLS 2
#define MISC 3

// Pointer tuning (carried over from the old config)
&mmv {
    acceleration-exponent = <1>;    // 1
    time-to-max-speed-ms = <900>;   // 40
    delay-ms = <0>;                 // 0
};

&msc {
    acceleration-exponent = <1>;    // 0
    time-to-max-speed-ms = <400>;   // 500
    delay-ms = <0>;                 // 10
};

/ {
    behaviors {
        mousescroll: mousescroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "default";

            bindings = <
&kp ESC     &kp N1    &kp N2      &kp N3     &kp N4     &kp N5     &kp N6        &kp N7     &kp N8      &kp N9    &kp N0     &kp BACKSPACE
&kp TAB     &kp Q     &kp W       &kp E      &kp R      &kp T      &kp Y         &kp U      &kp I       &kp O     &kp P      &kp MINUS
&kp LCTRL   &kp A     &kp S       &kp D      &kp F      &kp G      &kp H         &kp J      &kp K       &kp L     &kp SEMI   &kp SQT
&kp LSHFT   &kp Z     &kp X       &kp C      &kp V      &kp B      &kp N         &kp M      &kp COMMA   &kp DOT   &kp FSLH   &kp RSHFT
&kp ESC   &mo MISC    &kp LALT   &kp SPACE  &kp LGUI   &mo CONTROLS  &kp BSPC   &mo SYMBOLS &mo MISC  &kp RET  &kp ENTER
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        controls_layer {
            label = "controls";

            bindings = <
&trans  &trans         &trans           &trans         &trans    &trans   &trans      &trans      &trans    &trans     &trans  &trans
&trans  &kp F1         &kp F2           &kp F3         &kp F4    &kp F5   &kp F6      &kp F7      &kp F8    &kp F9     &kp F10 &kp F11
&trans  &trans         &kp PRINTSCREEN  &trans         &kp BSPC  &trans   &kp LEFT    &kp DOWN    &kp UP    &kp RIGHT  &kp DEL &kp F12
&trans  &kp C_PREV     &kp C_PLAY       &kp C_NEXT     &trans    &trans   &kp HOME    &kp PG_DN   &kp PG_UP &kp END    &trans  &trans
&trans  &trans         &trans           &trans         &trans    &trans   &trans      &trans      &trans    &trans     &trans
            >;

            sensor-bindings = <&mousescroll &inc_dec_kp PG_UP PG_DN>;
        };

        symbols_layer {
            label = "symbols";

            bindings = <
&trans  &trans      &trans      &trans      &trans      &trans       &trans      &trans      &trans           &trans      &trans      &trans
&trans  &kp N1      &kp N2      &kp N3      &kp N4      &kp N5       &kp N6      &kp N7      &kp N8           &kp N9      &kp N0      &kp PLUS
&trans  &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT    &kp CARET   &kp AMPS    &kp KP_ASTERISK  &kp LPAR    &kp RPAR    &kp EQUAL
&trans  &kp GRAVE   &kp TILDE   &trans      &trans      &trans       &kp PIPE    &kp LBKT    &kp RBKT         &kp LBRC    &kp RBRC    &kp BACKSLASH
&trans  &trans      &trans      &trans      &trans      &trans       &trans      &trans      &trans           &trans      &trans
            >;

            sensor-bindings = <&mousescroll &inc_dec_kp PG_UP PG_DN>;
        };

        misc_layer {
            label = "misc";

            bindings = <
&trans           &trans         &trans          &trans           &trans            &trans   &trans       &trans         &trans          &trans        &trans         &trans
&msc SCRL_LEFT   &msc SCRL_UP   &mmv MOVE_UP    &msc SCRL_DOWN   &msc SCRL_RIGHT   &none    &bt BT_CLR   &trans         &studio_unlock  &out OUT_TOG  &trans         &trans
&mkp LCLK        &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none             &none    &trans       &bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4
&mkp RCLK        &none          &none           &none            &none             &none    &trans       &trans         &trans          &trans        &trans         &trans
&trans           &trans         &trans          &trans           &trans            &trans   &trans       &trans         &trans          &trans        &trans
            >;

            sensor-bindings = <&mousescroll &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
